# Clean core
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8768
JARVIS_DATA_DIR=./data
JARVIS_HISTORY_DIR=./history
JARVIS_CHAINS=sol,base,eth,bsc
JARVIS_YOUNG_MAX_AGE_SECONDS=900
JARVIS_OBSERVATION_FRESH_SECONDS=180
JARVIS_TAPE_RETENTION_HOURS=72
JARVIS_GECKO_NEW_INTERVAL_SECONDS=45
JARVIS_GECKO_TRENDING_INTERVAL_SECONDS=60
JARVIS_DEX_PROFILE_INTERVAL_SECONDS=60
JARVIS_DEX_RECONCILE_INTERVAL_SECONDS=12
JARVIS_HTTP_TIMEOUT_SECONDS=15

# Step 2 research
JARVIS_ARCHIVE_EXPORT_BATCH_ROWS=10000
JARVIS_SCIENCE_MIN_SAMPLES=30

# Step 3 risk evidence. Disabled until explicitly enabled/configured.
JARVIS_GOPLUS_ENABLED=0
JARVIS_GOPLUS_BASE_URL=https://api.gopluslabs.io
# JARVIS_GOPLUS_TOKEN=
JARVIS_RISK_INTERVAL_SECONDS=120
JARVIS_RISK_REFRESH_SECONDS=900
JARVIS_RISK_MAX_TARGETS_PER_CYCLE=10

# Step 3 local agents. Ollama is optional; core research is independent of it.
OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_OLLAMA_REFRESH_SECONDS=60
JARVIS_AGENTS_ENABLED=1

# Semantic attention compilation
JARVIS_ATTENTION_DEBOUNCE_SECONDS=2
JARVIS_ATTENTION_COOLDOWN_SECONDS=120
JARVIS_EVIDENCE_QUEUE_MAX=4096
